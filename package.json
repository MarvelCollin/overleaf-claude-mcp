{
  "name": "overleaf-claude-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing your Overleaf projects to Claude via an authenticated browser session.",
  "bin": {
    "overleaf-claude-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "login": "tsx src/auth/login.ts",
    "recon": "tsx src/recon.ts",
    "smoke": "tsx src/smoke.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
